{
  "name": "job-hunt-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Personal job-search platform: aggregate, filter and track roles, exposed to Claude via MCP.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jhc/web",
    "build": "npm run build -w @jhc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @jhc/core",
    "db:migrate": "tsx packages/core/src/scripts/migrate.ts",
    "import:json": "tsx packages/core/src/scripts/import-json.ts",
    "import:scraped": "tsx packages/core/src/scripts/import-json.ts scrapers/all_jobs.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
